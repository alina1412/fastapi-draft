{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Pytest Async",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_db_accessors.py::test_db_create",
                "-v",
                "-s", // This is IMPORTANT for async debugging
                "-x",
                "--color=yes",
                "--asyncio-mode=auto"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "service.__main__:app",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ]
}